{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroslove-ai.github.io/video-production-skills/previs/shot-manifest.schema.json",
  "title": "ShotManifest",
  "description": "Provider-neutral handoff manifest from Blender previs to AI video generation.",
  "type": "object",
  "required": [
    "manifest_version",
    "shot_id",
    "timeline",
    "image",
    "camera",
    "render_passes",
    "prompts",
    "seed",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "timeline": { "$ref": "#/$defs/timeline" },
    "image": { "$ref": "#/$defs/image" },
    "camera": { "$ref": "#/$defs/camera" },
    "characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" },
      "default": []
    },
    "render_passes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/render_pass" }
    },
    "control_passes": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_pass" },
      "default": []
    },
    "prompts": { "$ref": "#/$defs/prompts" },
    "seed": { "$ref": "#/$defs/seed" },
    "keyframes_contact_sheet": { "$ref": "#/$defs/keyframes_contact_sheet" },
    "optional_hooks": { "$ref": "#/$defs/optional_hooks" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "timeline": {
      "type": "object",
      "required": ["fps", "frame_start", "frame_end"],
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 }
      }
    },
    "image": {
      "type": "object",
      "required": ["width", "height", "aspect_ratio"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        }
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "camera_keyframe": {
      "type": "object",
      "required": ["frame", "location", "rotation_euler_xyz_rad"],
      "additionalProperties": false,
      "properties": {
        "frame": { "type": "integer", "minimum": 0 },
        "location": { "$ref": "#/$defs/vec3" },
        "rotation_euler_xyz_rad": { "$ref": "#/$defs/vec3" },
        "fov_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
        "focal_length_mm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "camera": {
      "type": "object",
      "required": ["sensor_width_mm", "keyframes"],
      "additionalProperties": false,
      "properties": {
        "sensor_width_mm": { "type": "number", "exclusiveMinimum": 0 },
        "default_focal_length_mm": { "type": "number", "exclusiveMinimum": 0 },
        "default_fov_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/camera_keyframe" }
        }
      }
    },
    "character": {
      "type": "object",
      "required": ["character_id", "keyframes"],
      "additionalProperties": false,
      "properties": {
        "character_id": { "type": "string", "minLength": 1 },
        "action_refs": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["frame", "location", "rotation_euler_xyz_rad"],
            "additionalProperties": false,
            "properties": {
              "frame": { "type": "integer", "minimum": 0 },
              "location": { "$ref": "#/$defs/vec3" },
              "rotation_euler_xyz_rad": { "$ref": "#/$defs/vec3" }
            }
          }
        }
      }
    },
    "render_pass": {
      "type": "object",
      "required": ["id", "type", "relative_path", "frame_start", "frame_end"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["rgb", "depth", "normals", "object_mask", "character_mask"]
        },
        "relative_path": { "type": "string", "minLength": 1 },
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "control_pass": {
      "type": "object",
      "required": ["id", "type", "relative_path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["pose_projection", "skeleton_2d", "motion_vectors", "camera_json"]
        },
        "relative_path": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean", "default": true },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "prompts": {
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string" },
        "negative_prompt": { "type": "string", "default": "" },
        "style_tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "seed": {
      "type": "object",
      "required": ["value", "policy"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer" },
        "policy": {
          "type": "string",
          "enum": ["fixed", "per_shot_derived", "provider_assign"]
        },
        "derivation": { "type": "string" }
      }
    },
    "keyframes_contact_sheet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "representative_frames": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "contact_sheet_relative_path": { "type": "string" },
        "columns": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "optional_hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pose_projection": {
          "type": "string",
          "enum": ["not_exported", "exported", "skipped_unavailable"]
        },
        "motion_vectors": {
          "type": "string",
          "enum": ["not_exported", "exported", "skipped_unavailable"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "authoritative_sources",
        "export_tool",
        "export_mode",
        "exported_at"
      ],
      "additionalProperties": false,
      "properties": {
        "authoritative_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["uri", "sha256", "role"],
            "additionalProperties": false,
            "properties": {
              "uri": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "role": {
                "type": "string",
                "enum": ["blend", "bpy_script", "reference_image", "synthetic_fixture"]
              }
            }
          }
        },
        "export_tool": { "type": "string", "minLength": 1 },
        "export_mode": {
          "type": "string",
          "enum": ["blender", "synthetic"]
        },
        "blender_runtime": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_TESTED", "SKIPPED"]
        },
        "exported_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
