  "head": {
    "properties": {
      "neck_v3": "Rest-space neck color and roughness masks; smootherstep transitions; local Taubin relaxation, unchanged topology and rig",
      "refined4": "Neck shortened 9 mm with smooth transition, neck contour relaxed; rest neck/head/eye bones and shader coordinates remapped",
      "facial_controls": "Object Data > Shape Keys: JawOpen, Smile.L, Smile.R. 0 = exact neutral. Conservative test ranges, not production certification.",
      "blink_status": "Existing full-closure blink keys and gaze are preserved; see prior face geometry QA limitations.",
      "Face rig quality": "Refined face retained: 72 shape keys and 50 drivers. No phoneme/lip-sync or automatic contact certification.",
      "Eye rebuild": "Welded continuous eyelid skin with fixed lower lid, true fitted globes behind immutable iris caps, and root-bound lash motion. Original body/rig/actions preserved. See eye rebuild report.",
      "Lash refinement": "Uniform dark brown lash pigment on existing true lash geometry. Source silhouette and root-bound corrective motion unchanged.",
      "Face_GazeYaw": 0.0,
      "Face_GazePitch": 0.0,
      "Face gaze notes": "True rigid eye-volume/iris motion, ±6° yaw / ±4° pitch. Native Geometry Nodes smoothly ease source-fit posterior clearance up to 0.65 mm yaw plus 0.45 mm down gaze (1.10 mm combined). Exact neutral bypass and fixed socket/lower lid. Only simple built-in driver expressions are used; no script auto-execution required. Export requires baking or a dedicated export rig.",
      "Face expression controls": "BrowRaise.L/R, BrowKnit.L/R, CheekLift.L/R, LipPucker, MouthWide are conservative native surface deformations. CORR_Face_* are automatic cheek-volume correctives; do not animate directly.",
      "_Face_gaze_clearance_mode": "smooth_native_nodes_v5",
      "_Face_gaze_clearance_formula": ".00065*(sqrt(min(1,yaw*yaw)+.0004)-.02)/0.980199980003999+.00045*(sqrt(max(0,min(1,-pitch))**2+.0004)-.02)/0.980199980003999",
      "Face r2": "Three additive local shapes and bounded presets. Original shape keys and fixed lower eyelids preserved. Strength 0 returns exact neutral. No ARKit or phoneme mapping claimed.",
      "Clean_Base_R3": "Bikini geometry removed. New neutral 2K skin bake. Original rig, body proportions, face and current separate hair retained.",
      "Clean_Base_R3_Source": "Character_Master_R2.blend; SHA256 5e88819a61120b74c9a0e3de03f90b9890b7ac13eea2113e10fcada321d21d2e",
      "Clean_Base_R3_HoleRepair": "Closed one pre-existing 4-edge underarm/torso slit with two faces; no vertices moved or added.",
      "Assembly_Role": "Original refined face; exact retained R3 geometry, UVs, shape keys and weights.",
      "Assembly_Source": "Character_CleanBase_R3.blend",
      "EyelidSurface_R3_Applied": true,
      "EyelidSurface_R3_Description": "Harmonic upper-lid interior parameter spacing with smooth thin-plate depth reconstruction from surrounding skin and closure boundaries,8 held-blink samples,0.25mm globe clearance bound. Neutral face, materials, UV and all expressions remain unchanged.",
      "EyelidPigment_R3_Applied": true,
      "EyelidPigment_R3_Description": "Smooth clean-skin pigment from existing atlas interior, broad upper-lid region and softly feathered head-skin halo. Original images and UV unchanged. Neutral factor zero; brows, lower lids and identity retained.",
      "LashRoot_R3_Applied": true,
      "LashRoot_R3_Description": "Malformed medial fringe replaced by smooth continuous lid margin and tapered lashes, native9-sample rim following. Outer original lashes retained; all head keys and rig preserved.",
      "OriginalFringeBandTransport": true,
      "R4_NeckAlignment": "Neutral neck re-centered to face/rig x=.00195 with smooth local join reconstruction; no face geometry above z=.843 changed, expression deltas preserved."
    },
